# Nilai di file ini untuk LOKAL. Yang wajib beda di produksi ditandai "PRODUKSI:".
APP_NAME="Umroh Sakti"
APP_ENV=local
# PRODUKSI: `php artisan key:generate` sekali, lalu jangan diganti — session &
# cookie terenkripsi dengannya, ganti key = semua orang ter-logout.
APP_KEY=
# PRODUKSI: false. `true` menampilkan stack trace + isi env di halaman error —
# itu jalur bocornya IG_ACCESS_TOKEN & AI_API_KEY yang paling gampang.
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# --- Login (Google SSO, satu-satunya gerbang) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID,
# tipe "Web application". Authorized redirect URI wajib persis:
#   http://localhost:8000/login/callback   (lokal)
#   https://<domain>/login/callback        (produksi)
# Kosong = tombol masuknya menolak dengan pesan, bukan error 500.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cuma diisi kalau URI yang didaftarkan beda dari route('login.callback') —
# misalnya proxy yang menulis ulang path. Google mencocokkan string persis.
GOOGLE_REDIRECT_URI=

# Session dipakai buat login operator (/login). Tabelnya `sessions`.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# PRODUKSI: true (wajib HTTPS) — tanpa ini cookie sesi ikut terkirim lewat http
# dan siapa pun di jaringan yang sama bisa memakainya untuk membuka /akun.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Tempat flyer paket yang sudah lolos import. local = storage/flyers.
# Produksi: s3 (isi AWS_ACCESS_KEY_ID/SECRET/DEFAULT_REGION/BUCKET, endpoint untuk R2).
FLYER_DISK=local
QUEUE_CONNECTION=database
# Wajib > timeout job terpanjang (ExtractPending = 3600s). Kalau lebih kecil,
# queue menganggap job yang masih jalan itu mati dan menyerahkannya ke worker
# lain -> fetch/extract jalan dobel.
DB_QUEUE_RETRY_AFTER=7200

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Instagram / ekstraksi (probe.php) ---
# Scope WAJIB: instagram_basic, instagram_manage_insights, pages_show_list,
#             pages_read_engagement, business_management
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v25.0
# Jeda detik sebelum tiap request ke graph.facebook.com (boleh pecahan). Antrian
# `ig` satu worker, jadi ini sekaligus jarak antar-halaman dan antar-akun.
# Override sekali jalan: `probe.php fetch <username> --sleep=5`.
IG_FETCH_SLEEP=3
# Cuma `probe.php auth`. Satu nilai, atau daftar JSON berkutip (urutan sama dengan
# IG_ACCESS_TOKEN) lalu pilih dengan `auth <short_token> --app=N`.
META_APP_ID=
META_APP_SECRET=
# Semua LLM lewat 9router (OpenAI-compatible). Satu URL + satu key, beda `model`.
# Isinya nama COMBO yang dirakit di dashboard router: giliran + failover antar-model
# dikerjakan di sana, jadi satu nama sudah cukup. Kalau menyebut model langsung,
# namanya WAJIB berprefix provider (nama polos diarahkan ke provider openai) dan
# WAJIB daftar JSON berisi > 1 model — routernya menggantung, bukan menolak.
AI_API_KEY=
# Penyusun JSON (teks saja).
EXTRACT_MODEL=logic-model
AI_API_URL=https://9router.jinno.my.id/v1/chat/completions

# Mata: baca flyer -> teks mentah. SEMUA anggota combo ini wajib bisa vision: model
# tanpa vision dibuang gambarnya diam-diam oleh router dan tetap balas 200 — uji tiap
# anggota baru dengan flyer yang jawabannya sudah diketahui.
VISION_MODEL=image-model

# Batas satu request ke router (detik). Timeout diulang seketika (POST baru = key
# baru), maksimal dua percobaan, lalu pindah model. Anggarannya harus muat di
# ExtractPost::$timeout: AI_TIMEOUT x 2 x jumlah model, dikali (1 vision + N slide).
AI_TIMEOUT=60
